        },
        "tooltip": {
          "mode": "multi",
          "sort": "descending"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (rate(container_network_receive_bytes_total{container!=\"\",container!=\"POD\"}[1m]))",
          "legendFormat": "{{container}} - RX (In)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
