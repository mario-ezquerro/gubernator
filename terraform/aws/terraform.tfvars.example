aws_region            = "eu-west-1"
cluster_name          = "gbnt-cluster"
manager_instance_type = "t3.medium"
worker_instance_type  = "t3.small"
worker_count          = 2
ssh_public_key_path   = "~/.ssh/id_rsa.pub"
ssh_private_key_path  = "~/.ssh/id_rsa"
ssh_user              = "ubuntu"
root_volume_size      = 30
