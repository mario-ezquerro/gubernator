# Gubernator Environment Variables

# Habilita la Interfaz Web en el puerto 4001
GBNT_WEB=true

# Credenciales para acceder a la Interfaz Web (Basic Auth)
GBNT_WEB_USER=admin
GBNT_WEB_PASSWORD=admin

# Habilita la inicialización del stack de observabilidad SRE (Prometheus, Grafana, Loki, etc.)
GBNT_MONITOR=true
GBNT_HOST_IP=192.168.130.78
