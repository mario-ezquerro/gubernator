{
    "swagger": "2.0",
    "info": {
        "description": "This is the API Server for Gubernator orchestration.",
        "title": "Gubernator API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:4000",
    "basePath": "/",
    "paths": {
        "/v1/cluster/token": {
            "get": {
                "description": "Retrieve the current global join token (requires local access)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "legion"
                ],
                "summary": "Get Cluster Join Token",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/node/heartbeat": {
            "post": {
                "description": "Nodes call this to let the manager know they are alive",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "legion"
                ],
                "summary": "Node Heartbeat",
                "parameters": [
                    {
                        "description": "Heartbeat Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.HeartbeatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/node/join": {
            "post": {
                "description": "Register a new worker node in the Gubernator cluster using a Join Token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "legion"
                ],
                "summary": "Join the cluster",
                "parameters": [
                    {
                        "description": "Join Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.JoinRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/node/ls": {
            "get": {
                "description": "Get a list of all nodes currently registered in the Gubernator cluster from SQLite",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "nodes"
                ],
                "summary": "List all nodes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.NodeListResponse"
                        }
                    }
                }
            }
        },
        "/v1/node/tasks/{node_id}": {
            "get": {
                "description": "Fetches pending tasks for the worker to execute",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Get assigned tasks for a node",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Node ID",
                        "name": "node_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.TaskResponse"
                        }
                    }
                }
            }
        },
        "/v1/node/tasks/{task_id}/status": {
            "post": {
                "description": "Worker reports back whether the task is running or failed",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Update task status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Task ID",
                        "name": "task_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Status Update",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.TaskStatusRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/stack/deploy": {
            "post": {
                "description": "Parse a docker-compose yaml and schedule tasks to nodes",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stack"
                ],
                "summary": "Deploy a Stack",
                "parameters": [
                    {
                        "description": "Stack Deploy Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.StackDeployRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_mario-ezquerro_gubernator_internal_db.Node": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "labels": {
                    "description": "Parsed labels for the application",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "role": {
                    "description": "e.g., \"manager\", \"worker\"",
                    "type": "string"
                },
                "status": {
                    "description": "e.g., \"active\", \"down\", \"drain\"",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "github_com_mario-ezquerro_gubernator_internal_db.Task": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "node_id": {
                    "type": "string"
                },
                "service_id": {
                    "type": "string"
                },
                "status": {
                    "description": "\"pending\", \"running\", \"dead\"",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_api.HeartbeatRequest": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string"
                }
            }
        },
        "internal_api.JoinRequest": {
            "type": "object",
            "required": [
                "id",
                "ip",
                "token"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "labels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "internal_api.NodeListResponse": {
            "type": "object",
            "properties": {
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_mario-ezquerro_gubernator_internal_db.Node"
                    }
                }
            }
        },
        "internal_api.StackDeployRequest": {
            "type": "object",
            "required": [
                "compose_raw",
                "name"
            ],
            "properties": {
                "compose_raw": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "internal_api.TaskResponse": {
            "type": "object",
            "properties": {
                "tasks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_api.TaskWithImage"
                    }
                }
            }
        },
        "internal_api.TaskStatusRequest": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        },
        "internal_api.TaskWithImage": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string"
                },
                "task": {
                    "$ref": "#/definitions/github_com_mario-ezquerro_gubernator_internal_db.Task"
                }
            }
        }
    }
}